<controls:Page x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Roblox"
    xmlns:controls="using:Roblox.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Class="Roblox.AppShell"
    TabNavigation="Cycle">
    <controls:Page.Content>
        <Grid>
        <Grid.Children>
            <SplitView x:Name="RootSplitView"
                OpenPaneLength="60"
                IsTabStop="False"
                DisplayMode="Inline"
                PaneBackground="#00FFFFFF"
                AllowDrop="False"
                CanDrag="False"
                IsPaneOpen="True">
                <SplitView.Pane>
                    <controls:NavMenu x:Name="NavMenuList"
                        TabIndex="3"
                        Margin="0"
                        Background="#FF2E2E2E"
                        Foreground="#FFFFFFFF"
                        ItemContainerStyle="{StaticResource NavMenuItemContainerStyle}" />
                </SplitView.Pane>
                <SplitView.Content>
                    <Frame x:Name="frame" Margin="0" />
                </SplitView.Content>
            </SplitView>
            <ToggleButton x:Name="TogglePaneButton"
                TabIndex="1"
                Style="{StaticResource SplitViewTogglePaneButtonStyle}"
                ToolTipService.ToolTip="Menu"
                Visibility="Collapsed">
                <ToggleButton.IsChecked>
                    <Binding Path="IsPaneOpen" ElementName="RootSplitView" Mode="TwoWay" />
                </ToggleButton.IsChecked>
            </ToggleButton>
        </Grid.Children>
        </Grid>
    </controls:Page.Content>
</controls:Page>
