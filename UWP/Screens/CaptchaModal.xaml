<ContentDialog
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Roblox"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Class="Roblox.Views.CaptchaModal"
    Width="500"
    Height="400">
    <ContentDialog.Content>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.Children>
                                <Grid Grid.Row="0" Background="{ThemeResource SystemControlHighlightAccentBrush}" Margin="-30,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="10" />
                    </Grid.ColumnDefinitions>
                    <Grid.Children>
                        <TextBlock x:Name="txtTitle"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            Margin="20,0"
                            Grid.Column="1"
                            FontWeight="Bold"
                            FontSize="17"
                            Foreground="#FFFFFFFF"
                            Text="CaptchaTitle" />
                        <Button x:Name="btnClose"
                            Background="#00FFFFFF"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Grid.Column="2"
                            Width="50"
                            Height="50">
                            <Button.Content>
                                <Image x:Name="btnClose_image"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Stretch="Fill"
                                    Width="32"
                                    Height="32" />
                            </Button.Content>
                        </Button>
                    </Grid.Children>
                </Grid>
                <StackPanel x:Name="captchaNativeForm" Width="450" Grid.Row="1" Visibility="Visible" VerticalAlignment="Center">
                    <StackPanel.Children>
                        <TextBlock x:Name="captchaTitleText" HorizontalAlignment="Center" Text="_Please solve the Captcha to prove you aren't a robot._" FontSize="18" Foreground="#FF000000" />
                        <Image x:Name="captchaImage" Width="300" Height="57" Margin="0,10" />
                        <TextBox x:Name="captchaTextBox" Width="300" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                            <StackPanel.Children>
                                <Button x:Name="captchaCancelButton"
                                    Background="#FFFFFFFF"
                                    Content="Cancel"
                                    Width="100"
                                    Height="40"
                                    FontSize="18"
                                    BorderBrush="#FF000000"
                                    BorderThickness="0.8" />
                                <Button x:Name="captchaAcceptButton"
                                    Margin="20,0,0,0"
                                    Content="Submit"
                                    Width="100"
                                    Height="40"
                                    FontSize="18"
                                    Background="{StaticResource RbxBlue2}"
                                    BorderBrush="#FF000000"
                                    BorderThickness="0.8" />
                            </StackPanel.Children>
                        </StackPanel>
                    </StackPanel.Children>
                </StackPanel>
                <WebView x:Name="captchaWebview"
                    Grid.Row="1"
                    Width="450"
                    Height="350"
                    Visibility="Collapsed"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" />
            </Grid.Children>
        </Grid>
    </ContentDialog.Content>
</ContentDialog>