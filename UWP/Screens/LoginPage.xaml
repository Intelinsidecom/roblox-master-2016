<ContentDialog
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Roblox"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Class="Roblox.Views.LoginPage"
    MaxWidth="1000">
    <ContentDialog.Content>
        <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <Grid.Children>
                <StackPanel Width="600" Height="400" Orientation="Vertical" Background="{StaticResource RbxShadow}">
                    <StackPanel.Children>
                        <StackPanel Margin="10" Background="#FFFFFFFF" Padding="20,10,0,0" Height="380">
                            <StackPanel.Children>
                                <TextBlock Text="Login" Foreground="#FF000000" FontSize="36" />
                                <TextBlock Text="Username" Foreground="#FF000000" FontSize="22" Margin="0,10,0,0" />
                                <TextBox x:Name="username_textbox" Background="{StaticResource RbxGray5}" HorizontalAlignment="Left" Width="540" InputScope="EmailNameOrAddress" />
                                <TextBlock Text="Password" Foreground="#FF000000" FontSize="22" Margin="0,10,0,0" />
                                <PasswordBox x:Name="password_textbox" Background="{StaticResource RbxGray5}" Width="540" HorizontalAlignment="Left" />
                                <TextBlock x:Name="status_display"
                                    Text="Error placeholder text."
                                    Margin="0,10,0,0"
                                    Width="540"
                                    Foreground="#FFFFFFFF"
                                    FontSize="16" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                                    <StackPanel.Children>
                                        <Button x:Name="login_button"
                                            Content="Login"
                                            Width="100"
                                            Height="40"
                                            FontSize="18"
                                            Background="{StaticResource RbxBlue2}"
                                            BorderBrush="#FF000000"
                                            BorderThickness="0.8" />
                                        <Button x:Name="cancel_button"
                                            Margin="20,0,0,0"
                                            Background="#FFFFFFFF"
                                            Content="Cancel"
                                            Width="100"
                                            Height="40"
                                            FontSize="18"
                                            BorderBrush="#FF000000"
                                            BorderThickness="0.8" />
                                    </StackPanel.Children>
                                </StackPanel>
                                <Button x:Name="signup_button"
                                    Content="New to ROBLOX? Create an account."
                                    HorizontalAlignment="Center"
                                    Background="#FFFFFFFF"
                                    Foreground="{StaticResource RbxBlue3}"
                                    Margin="0,10,0,0" />
                            </StackPanel.Children>
                        </StackPanel>
                    </StackPanel.Children>
                </StackPanel>
            </Grid.Children>
        </Grid>
    </ContentDialog.Content>
</ContentDialog>
