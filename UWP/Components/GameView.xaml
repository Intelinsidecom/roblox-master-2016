<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Roblox.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Class="Roblox.Controls.GameView">
    <UserControl.Content>
        <Grid>
            <Grid.Children>
                <SwapChainPanel x:Name="rbxSwapChain" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
                <TextBox x:Name="ChatTextBox"
                    FontSize="18.667"
                    InputScope="Text"
                    VerticalAlignment="Top"
                    Visibility="Collapsed"
                    BorderBrush="#FFFFFFFF"
                    Margin="0,32,0,0">
                    <TextBox.Background>
                        <SolidColorBrush Color="#FFFFFFFF" Opacity="0.8" />
                    </TextBox.Background>
                </TextBox>
            </Grid.Children>
        </Grid>
    </UserControl.Content>
</UserControl>
