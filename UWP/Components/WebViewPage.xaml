<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Roblox"
    xmlns:controls="using:Roblox.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Class="Roblox.Controls.WebViewPage">
    <UserControl.Content>
        <Grid x:Name="pageBackground" Background="#FF000000">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.Children>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="420" />
                    </Grid.ColumnDefinitions>
                    <Grid.Children>
                        <TextBlock
                            VerticalAlignment="Center"
                            Margin="20,0"
                            FontWeight="Bold"
                            Foreground="#FFFFFFFF"
                            FontSize="17"
                            Grid.Column="0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Column="1">
                            <StackPanel.Children>
                                <Button x:Name="btnBC"
                                    Width="50"
                                    Height="50"
                                    Background="#00FFFFFF"
                                    BorderBrush="#00FFFFFF"
                                    BorderThickness="0">
                                    <Button.Content>
                                        <Image x:Name="btnBC_image"
                                            Width="32"
                                            Height="32"
                                            Stretch="Fill"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center" />
                                    </Button.Content>
                                </Button>
                                <Button x:Name="btnRobux"
                                    Height="50"
                                    MinWidth="50"
                                    Background="#00FFFFFF"
                                    BorderBrush="#00FFFFFF"
                                    BorderThickness="0">
                                    <Button.Content>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <StackPanel.Children>
                                                <Image x:Name="btnRobux_image" Width="32" Height="32" Stretch="Fill" />
                                                <TextBlock x:Name="btnRobux_balance"
                                                    MaxWidth="60"
                                                    Margin="5,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontWeight="Bold"
                                                    FontSize="17"
                                                    Foreground="#FFFFFFFF"
                                                    Visibility="Visible" />
                                            </StackPanel.Children>
                                        </StackPanel>
                                    </Button.Content>
                                </Button>
                                <AutoSuggestBox x:Name="asbSearch"
                                    Width="250"
                                    TabIndex="3"
                                    VerticalAlignment="Center"
                                    Margin="5"
                                    QueryIcon="Find"
                                    FontSize="19"
                                    Visibility="Collapsed"
                                    Foreground="#FFFFFFFF"
                                    Background="#FF000000"
                                    BorderThickness="1"
                                    BorderBrush="#FFFFFFFF" />
                            </StackPanel.Children>
                        </StackPanel>
                    </Grid.Children>
                </Grid>
                <controls:WebView x:Name="wvContent" TabIndex="1" Grid.Row="1" />
            </Grid.Children>
        </Grid>
    </UserControl.Content>
</UserControl>